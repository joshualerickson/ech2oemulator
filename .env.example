# Copy to .env or export these variables in your shell on a new machine.
# Raw ECH2O site data is passed as --data-root to scripts, not stored in Git.
ECH2O_TWI_PATH=/path/to/CONUS_TWI_epsg5072_30m_unmasked.tif
ECH2O_FAC_PATH=/path/to/fac.vrt
ECH2O_PSST_PATH=/path/to/psst_q95_1982-2018_30m.tif
ECH2O_WBDEF_PATH=/path/to/wbdef.tif
